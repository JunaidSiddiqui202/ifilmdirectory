rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Designated system super-admins via trusted auth tokens / allowlist
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'junaid202@gmail.com' || 
        request.auth.token.email == 'junaid202@hotmail.com'
      );
    }

    // Check if user is admin - checks super-admin email OR non-client-tampered admin document
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') in ['super_admin', 'user_manager', 'ad_manager']
        )
      );
    }
    
    // Helper to verify sensitive privileged fields are not modified by regular users
    function notModifyingPrivilegedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'adminRole', 'verification', 'verification_tier', 'isVerified', 'accountStatus', 'abuseReports'
      ]);
    }

    // Helper to verify sensitive privileged fields are not set on creation by regular users
    function notSettingPrivilegedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'role', 'adminRole', 'verification', 'verification_tier', 'isVerified', 'accountStatus', 'abuseReports'
      ]) || (
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('adminRole' in request.resource.data) || request.resource.data.adminRole == null) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
        (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'active')
      );
    }
    
    // Validate data size (prevent large writes)
    function isValidSize() {
      return true;
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Anyone can read public user profiles
      allow read: if true;
      
      // Users can create their own profile, but cannot self-assign admin roles or verification
      allow create: if isAuthenticated() && 
                      request.auth.uid == userId &&
                      (isAdmin() || notSettingPrivilegedFieldsOnCreate());
      
      // Users can update their own profile, but CANNOT self-escalate roles or verification.
      // Admins can update any user profile and privileged fields.
      allow update: if (isAdmin()) || (
                      isOwner(userId) && notModifyingPrivilegedFields()
                    );
      
      // Only admins can delete users
      allow delete: if isAdmin();
      
      // Rate limit tracking subcollection (only owner or admin)
      match /rateLimits/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ============================================
    // PROFILES COLLECTION (Professional Profiles)
    // ============================================
    match /profiles/{profileId} {
      allow read: if true;
      
      // Authenticated users can create profiles, author must match auth UID
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Owner or admin can update
      allow update: if (isOwner(resource.data.userId) || isAdmin());
      
      // Owner or admin can delete
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // POSTS/SHOWCASE COLLECTION
    // ============================================
    match /posts/{postId} {
      allow read: if true;
      
      // Authenticated users can create posts, creator must match auth UID
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Owner or admin can update
      allow update: if (isOwner(resource.data.userId) || isAdmin());
      
      // Owner or admin can delete
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        (request.resource.data.userId == request.auth.uid || 
                         request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update, delete: if isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin();
      }
      
      // Likes subcollection (likeId is user UID)
      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && isOwner(likeId);
        allow delete: if isOwner(likeId) || isAdmin();
      }
    }

    // ============================================
    // TOP-LEVEL COMMENTS COLLECTION
    // ============================================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                      (request.resource.data.authorId == request.auth.uid || 
                       request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isOwner(resource.data.authorId) || isOwner(resource.data.userId) || isAdmin();
    }

    // ============================================
    // SAVED POSTS COLLECTION
    // ============================================
    match /saved_posts/{saveId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // ============================================
    // SAVED JOBS COLLECTION
    // ============================================
    match /saved_jobs/{saveId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // ============================================
    // REPORTS COLLECTION
    // ============================================
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
                      (request.resource.data.reporterId == request.auth.uid ||
                       request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // BLOGS & EVENTS COLLECTION
    // ============================================
    match /blogs/{blogId} {
      allow read: if true;
      
      // Authenticated users can create blogs, author must match auth UID
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid ||
                       request.resource.data.authorId == request.auth.uid || isAdmin());
      
      // Owner or admin can update/delete
      allow update, delete: if isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin();
      
      // Comments on blogs
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        (request.resource.data.userId == request.auth.uid || 
                         request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update, delete: if isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin();
      }
    }
    
    // ============================================
    // ACCESS REQUESTS COLLECTION
    // ============================================
    match /access_requests/{requestId} {
      allow read: if (request.auth != null && (resource.data.email == request.auth.token.email || (resource.data.userId != null && request.auth.uid == resource.data.userId))) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // PROJECTS COLLECTION (Production Projects)
    // ============================================
    match /projects/{projectId} {
      // Allow read only to project owner/producer, invited members, or admins
      allow read: if isAuthenticated() && (
        resource.data.producerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.isPublic == true ||
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      
      // Creator must be the authenticated user
      allow create: if isAuthenticated() && (
        request.resource.data.producerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      
      // Only owner, producer, or admin can update/delete project
      allow update, delete: if isAuthenticated() && (
        resource.data.producerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      
      // Project members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.producerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          request.auth.uid == memberId ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.producerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    // ============================================
    // BOOKINGS/FACILITIES COLLECTION
    // ============================================
    match /bookings/{bookingId} {
      // Users can read their own bookings, facility owners can read bookings for their facilities
      allow read: if isOwner(resource.data.userId) || 
                    isOwner(resource.data.facilityOwnerId) || 
                    isAdmin();
      
      // Authenticated users can create bookings for themselves
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can update their own bookings, facility owners can update status
      allow update: if (isOwner(resource.data.userId) || 
                       isOwner(resource.data.facilityOwnerId) || 
                       isAdmin());
      
      // Only owner or admin can delete
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // MESSAGES/CHAT COLLECTION
    // ============================================
    match /chats/{chatId} {
      // Restrict chat access strictly to participants in the thread or admin
      allow read: if isAuthenticated() && (
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*') ||
        isAdmin()
      );
      
      // Creating or updating a chat requires caller to be in participants
      allow create: if isAuthenticated() && (
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*') ||
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        (request.resource.data.participants != null && request.auth.uid in request.resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*') ||
        isAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
        isAdmin()
      );
      
      // Messages subcollection
      match /messages/{messageId} {
        // Read only if parent chat participant
        allow read: if isAuthenticated() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          chatId.matches('.*' + request.auth.uid + '.*') ||
          isAdmin()
        );
        
        // Sender must be authenticated and match senderId
        allow create: if isAuthenticated() && (
          request.resource.data.senderId == request.auth.uid ||
          isAdmin()
        );
        
        // Update (e.g. read receipts) or delete
        allow update: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])) ||
          isAdmin()
        );
        
        allow delete: if isAuthenticated() && (
          resource.data.senderId == request.auth.uid || isAdmin()
        );
      }
    }
    
    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Authenticated users can create notifications
      allow create: if isAuthenticated();
      
      // Users can update their own notifications (mark as read)
      allow update: if isOwner(resource.data.userId) || isAdmin();
      
      // Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // ANALYTICS COLLECTION (Admin only)
    // ============================================
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // SYSTEM CONFIGURATION (Admin write, public read)
    // ============================================
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ============================================
    // SHOWREELS/SHOWCASE COLLECTION
    // ============================================
    match /showreels/{showreelId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if (isOwner(resource.data.creatorId) || isOwner(resource.data.userId) || isAdmin());
      allow delete: if (isOwner(resource.data.creatorId) || isOwner(resource.data.userId) || isAdmin());
    }
    
    // ============================================
    // POLLS COLLECTION
    // ============================================
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isAdmin();
      // Allow authenticated users to vote, only updating voters / options counts
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // JOBS COLLECTION
    // ============================================
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if (isOwner(resource.data.userId) || isAdmin());
      allow delete: if (isOwner(resource.data.userId) || isAdmin());
    }

    match /job_applications/{applicationId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.jobOwnerId) || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.userId) || isOwner(resource.data.jobOwnerId) || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================
    // FOLLOWS COLLECTION
    // ============================================
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.followerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.followerId) || isAdmin());
    }

    // ============================================
    // AD CAMPAIGNS COLLECTION
    // ============================================
    match /ad_campaigns/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // FACILITIES/SERVICES COLLECTION
    // ============================================
    match /facilities/{facilityId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.userId) || isAdmin());
      allow delete: if (isOwner(resource.data.userId) || isAdmin());
    }
    
    // ============================================
    // GUILDS COLLECTION
    // ============================================
    match /guilds/{guildId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /guild_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /guild_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /guild_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ============================================
    // GROUPS & FORUM POSTS COLLECTION
    // ============================================
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.creatorId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (
        isOwner(resource.data.creatorId) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount'])) ||
        isAdmin()
      );
      allow delete: if isOwner(resource.data.creatorId) || isAdmin();
    }

    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.authorId) || isAdmin());
      allow delete: if (isOwner(resource.data.authorId) || isAdmin());
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.authorId) || isAdmin());
      allow delete: if (isOwner(resource.data.authorId) || isAdmin());
    }

    // ============================================
    // ADS COLLECTION
    // ============================================
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // DEFAULT DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Designated system super-admins via trusted auth tokens
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'junaid202@gmail.com' || 
        request.auth.token.email == 'junaid202@hotmail.com' ||
        request.auth.token.email == 'ifilmdirectory@gmail.com' ||
        request.auth.token.email == 'contact@ifilmdirectory.com'
      );
    }

    // Check if user is admin - checks super-admin email OR verified admin record
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('adminRole', '') in ['super_admin', 'user_manager', 'ad_manager']
        )
      );
    }
    
    // Helper: Disallow regular users from updating privileged administrative / verification fields
    function notModifyingPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'adminRole', 'verification', 'verification_tier', 'isVerified', 'accountStatus', 'abuseReports', 'warningCount'
      ]);
    }

    // Helper: Disallow regular users from initializing privileged fields on profile creation
    function notSettingPrivilegedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny([
        'role', 'adminRole', 'verification', 'verification_tier', 'isVerified', 'accountStatus', 'abuseReports', 'warningCount'
      ]);
    }

    // Helper: Prevent modifying OR removing creator/ownership identity after document creation
    function notModifyingOwner(ownerField) {
      return (ownerField in request.resource.data) && 
             (ownerField in resource.data) && 
             request.resource.data[ownerField] == resource.data[ownerField];
    }
    
    // Validate data size
    function isValidSize() {
      return true;
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow read: if true;
      
      // Users can create their own profile, but cannot initialize privileged roles/verification
      allow create: if isAuthenticated() && 
                      request.auth.uid == userId &&
                      (isAdmin() || notSettingPrivilegedFieldsOnCreate());
      
      // Users can update their own profile, but cannot alter privileged fields. Admins can update all.
      allow update: if (isAdmin()) || (
                      isOwner(userId) && notModifyingPrivilegedUserFields()
                    );
      
      // Only admins can delete users
      allow delete: if isAdmin();
      
      // Rate limit tracking subcollection
      match /rateLimits/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ============================================
    // PROFILES COLLECTION (Professional Profiles)
    // ============================================
    match /profiles/{profileId} {
      allow read: if true;
      
      // Creator must match auth UID, cannot self-assign verification
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isAdmin()) &&
                      (isAdmin() || !request.resource.data.keys().hasAny(['isVerified', 'verification', 'verification_tier']));
      
      // Owner or admin can update, but cannot reassign or remove userId
      allow update: if (isOwner(resource.data.userId) || isAdmin()) &&
                      notModifyingOwner('userId') &&
                      (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'verification', 'verification_tier']));
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // POSTS/SHOWCASE COLLECTION
    // ============================================
    match /posts/{postId} {
      allow read: if true;
      
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      
      // Owner or admin can update, but cannot transfer or delete ownership field
      allow update: if (isOwner(resource.data.userId) || isAdmin()) &&
                      notModifyingOwner('userId');
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        (request.resource.data.userId == request.auth.uid || 
                         request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update: if (isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin()) &&
                        notModifyingOwner('userId') && notModifyingOwner('authorId');
        allow delete: if isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin();
      }
      
      // Likes subcollection (likeId is user UID)
      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && isOwner(likeId);
        allow delete: if isOwner(likeId) || isAdmin();
      }
    }

    // ============================================
    // TOP-LEVEL COMMENTS COLLECTION
    // ============================================
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                      (request.resource.data.authorId == request.auth.uid || 
                       request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.authorId) || isOwner(resource.data.userId) || isAdmin()) &&
                      notModifyingOwner('authorId') && notModifyingOwner('userId');
      allow delete: if isOwner(resource.data.authorId) || isOwner(resource.data.userId) || isAdmin();
    }

    // ============================================
    // SAVED POSTS COLLECTION
    // ============================================
    match /saved_posts/{saveId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // ============================================
    // SAVED JOBS COLLECTION
    // ============================================
    match /saved_jobs/{saveId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow delete: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
    }

    // ============================================
    // REPORTS COLLECTION
    // ============================================
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
                      (request.resource.data.reporterId == request.auth.uid ||
                       request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // BLOGS & EVENTS COLLECTION
    // ============================================
    match /blogs/{blogId} {
      allow read: if true;
      
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid ||
                       request.resource.data.authorId == request.auth.uid || isAdmin());
      
      // Owner or admin can update, but cannot alter/remove authorId or userId
      allow update: if (isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin()) &&
                      notModifyingOwner('userId') && notModifyingOwner('authorId');
      allow delete: if isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin();
      
      // Comments on blogs
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        (request.resource.data.userId == request.auth.uid || 
                         request.resource.data.authorId == request.auth.uid || isAdmin());
        allow update: if (isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin()) &&
                        notModifyingOwner('userId') && notModifyingOwner('authorId');
        allow delete: if isOwner(resource.data.userId) || isOwner(resource.data.authorId) || isAdmin();
      }
    }
    
    // ============================================
    // ACCESS REQUESTS COLLECTION
    // ============================================
    match /access_requests/{requestId} {
      allow read: if (request.auth != null && (resource.data.email == request.auth.token.email || (resource.data.userId != null && request.auth.uid == resource.data.userId))) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // ============================================
    // PROJECTS COLLECTION (Production Projects)
    // ============================================
    match /projects/{projectId} {
      // Read allowed only to owner, producer, listed members, or public projects
      allow read: if isAuthenticated() && (
        resource.data.producerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.isPublic == true ||
        (resource.data.members != null && request.auth.uid in resource.data.members) ||
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)) ||
        isAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.producerId == request.auth.uid ||
        request.resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      
      // Only owner/producer can update, cannot alter or remove ownerId/producerId
      allow update: if isAuthenticated() && (
        resource.data.producerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      ) && notModifyingOwner('producerId') && notModifyingOwner('ownerId');

      allow delete: if isAuthenticated() && (
        resource.data.producerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      
      // Project members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.producerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          request.auth.uid == memberId ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.producerId == request.auth.uid ||
          get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    // ============================================
    // BOOKINGS/FACILITIES COLLECTION
    // ============================================
    match /bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || 
                    isOwner(resource.data.facilityOwnerId) || 
                    isAdmin();
      
      allow create: if isAuthenticated() &&
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      
      allow update: if (isOwner(resource.data.userId) || 
                       isOwner(resource.data.facilityOwnerId) || 
                       isAdmin()) && notModifyingOwner('userId');
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // MESSAGES/CHAT COLLECTION
    // ============================================
    match /chats/{chatId} {
      function isChatParticipant() {
        return isAuthenticated() && (
          (resource.data.participants != null && request.auth.uid in resource.data.participants) ||
          isAdmin()
        );
      }

      function isIncomingChatParticipant() {
        return isAuthenticated() && (
          (request.resource.data.participants != null && 
           request.resource.data.participants is list &&
           request.resource.data.participants.size() >= 1 &&
           request.resource.data.participants.size() <= 10 &&
           request.auth.uid in request.resource.data.participants &&
           (!('creatorId' in request.resource.data) || request.resource.data.creatorId == request.auth.uid)) ||
          isAdmin()
        );
      }

      allow read: if isChatParticipant();
      allow create: if isIncomingChatParticipant();
      
      // Updates allowed ONLY if caller is already a participant, participants list cannot be altered or injected,
      // and update keys are strictly limited to legitimate chat conversation metadata:
      allow update: if isChatParticipant() && (
        isAdmin() || (
          request.resource.data.participants == resource.data.participants &&
          (!('creatorId' in resource.data) || notModifyingOwner('creatorId')) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage', 'lastMessageTime', 'lastSenderId', 'updatedAt', 'unreadBy'
          ]) &&
          (
            !('lastSenderId' in request.resource.data) || 
            request.resource.data.lastSenderId == request.auth.uid ||
            request.resource.data.lastSenderId == resource.data.lastSenderId
          ) &&
          (
            !('lastMessage' in request.resource.data) ||
            (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000)
          ) &&
          (
            !('unreadBy' in request.resource.data) ||
            (request.resource.data.unreadBy is list &&
             resource.data.participants.hasAll(request.resource.data.unreadBy))
          )
        )
      );
      
      // Chat deletion restricted to administrators or original chat creator
      allow delete: if isAdmin() || (
        isAuthenticated() && 
        'creatorId' in resource.data && 
        resource.data.creatorId == request.auth.uid
      );
      
      // Messages subcollection
      match /messages/{messageId} {
        // Read only if verified member in parent chat
        allow read: if isAuthenticated() && (
          (get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null &&
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          isAdmin()
        );
        
        // Message creation requires verified membership in parent chat AND matching senderId
        allow create: if isAuthenticated() && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            request.resource.data.senderId == request.auth.uid
          ) || isAdmin()
        );
        
        // Message updates: Only sender can edit content
        allow update: if isAuthenticated() && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            resource.data.senderId == request.auth.uid &&
            notModifyingOwner('senderId')
          ) || isAdmin()
        );
        
        allow delete: if isAuthenticated() && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants != null &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            resource.data.senderId == request.auth.uid
          ) || isAdmin()
        );
      }
    }
    
    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Notification creation:
      // - Regular users can ONLY send user-level peer notifications ('like', 'comment', 'follow', 'job', 'connection', 'message')
      // - Sending 'system' notifications is strictly prohibited for standard users (reserved for admin/backend)
      // - Must not notify oneself
      // - Field keys strictly limited to permitted notification schema
      // - String length limits and initial unread status enforced
      allow create: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.keys().hasOnly(['userId', 'senderId', 'type', 'title', 'message', 'createdAt', 'isRead', 'actionLink', 'image', 'metadata']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.userId is string &&
          request.resource.data.userId.size() > 0 &&
          request.resource.data.userId != request.auth.uid &&
          request.resource.data.type in ['like', 'comment', 'follow', 'job', 'connection', 'message'] &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 200 &&
          request.resource.data.message is string &&
          request.resource.data.message.size() <= 1000 &&
          (!('actionLink' in request.resource.data) || (request.resource.data.actionLink is string && request.resource.data.actionLink.size() <= 500)) &&
          request.resource.data.isRead == false
        )
      );
      
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && notModifyingOwner('userId');
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // ANALYTICS COLLECTION (Admin only)
    // ============================================
    match /analytics/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // SYSTEM CONFIGURATION (Admin write, public read)
    // ============================================
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ============================================
    // SHOWREELS/SHOWCASE COLLECTION
    // ============================================
    match /showreels/{showreelId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.creatorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if (isOwner(resource.data.creatorId) || isOwner(resource.data.userId) || isAdmin()) &&
                      notModifyingOwner('creatorId') && notModifyingOwner('userId');
      allow delete: if (isOwner(resource.data.creatorId) || isOwner(resource.data.userId) || isAdmin());
    }
    
    // ============================================
    // POLLS COLLECTION
    // ============================================
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isAdmin();
      
      // Helper function to verify that exactly ONE option was incremented by 1,
      // all other options remained identical, and option text/ids were not altered:
      function isValidOptionIncrement() {
        let oldOpts = resource.data.options;
        let newOpts = request.resource.data.options;
        let n = oldOpts.size();

        // 2-Option Polls
        let valid2 = (n == 2) && (
          (
            newOpts[0].id == oldOpts[0].id && newOpts[0].text == oldOpts[0].text &&
            newOpts[1].id == oldOpts[1].id && newOpts[1].text == oldOpts[1].text
          ) && (
            (newOpts[0].votes == oldOpts[0].votes + 1 && newOpts[1].votes == oldOpts[1].votes) ||
            (newOpts[0].votes == oldOpts[0].votes && newOpts[1].votes == oldOpts[1].votes + 1)
          )
        );

        // 3-Option Polls
        let valid3 = (n == 3) && (
          (
            newOpts[0].id == oldOpts[0].id && newOpts[0].text == oldOpts[0].text &&
            newOpts[1].id == oldOpts[1].id && newOpts[1].text == oldOpts[1].text &&
            newOpts[2].id == oldOpts[2].id && newOpts[2].text == oldOpts[2].text
          ) && (
            (newOpts[0].votes == oldOpts[0].votes + 1 && newOpts[1].votes == oldOpts[1].votes && newOpts[2].votes == oldOpts[2].votes) ||
            (newOpts[0].votes == oldOpts[0].votes && newOpts[1].votes == oldOpts[1].votes + 1 && newOpts[2].votes == oldOpts[2].votes) ||
            (newOpts[0].votes == oldOpts[0].votes && newOpts[1].votes == oldOpts[1].votes && newOpts[2].votes == oldOpts[2].votes + 1)
          )
        );

        // 4-Option Polls
        let valid4 = (n == 4) && (
          (
            newOpts[0].id == oldOpts[0].id && newOpts[0].text == oldOpts[0].text &&
            newOpts[1].id == oldOpts[1].id && newOpts[1].text == oldOpts[1].text &&
            newOpts[2].id == oldOpts[2].id && newOpts[2].text == oldOpts[2].text &&
            newOpts[3].id == oldOpts[3].id && newOpts[3].text == oldOpts[3].text
          ) && (
            (newOpts[0].votes == oldOpts[0].votes + 1 && newOpts[1].votes == oldOpts[1].votes && newOpts[2].votes == oldOpts[2].votes && newOpts[3].votes == oldOpts[3].votes) ||
            (newOpts[0].votes == oldOpts[0].votes && newOpts[1].votes == oldOpts[1].votes + 1 && newOpts[2].votes == oldOpts[2].votes && newOpts[3].votes == oldOpts[3].votes) ||
            (newOpts[0].votes == oldOpts[0].votes && newOpts[1].votes == oldOpts[1].votes && newOpts[2].votes == oldOpts[2].votes + 1 && newOpts[3].votes == oldOpts[3].votes) ||
            (newOpts[0].votes == oldOpts[0].votes && newOpts[1].votes == oldOpts[1].votes && newOpts[2].votes == oldOpts[2].votes && newOpts[3].votes == oldOpts[3].votes + 1)
          )
        );

        // Option Key Invariant: Every option object must contain strictly and only ['id', 'text', 'votes']
        let keysValid = newOpts[0].keys().hasOnly(['id', 'text', 'votes']) &&
                        newOpts[1].keys().hasOnly(['id', 'text', 'votes']) &&
                        (n < 3 || newOpts[2].keys().hasOnly(['id', 'text', 'votes'])) &&
                        (n < 4 || newOpts[3].keys().hasOnly(['id', 'text', 'votes']));

        return keysValid && (valid2 || valid3 || valid4);
      }
      
      // Restrict poll updates strictly to legitimate single-vote operations on active polls:
      // 1. Poll must be active (active == true) and cannot be marked inactive by voters
      // 2. Question, type, active, createdAt cannot change
      // 3. User must not have already voted (!voters.hasAny([request.auth.uid]))
      // 4. Exactly one new voter (the calling user) must be added and old voters preserved
      // 5. totalVotes must increment by exactly 1
      // 6. Exactly ONE option count increments by 1, all other options unchanged (tamper-proof)
      // 7. Affected keys restricted strictly to ['voters', 'totalVotes', 'options']
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.active == true &&
          request.resource.data.active == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters', 'totalVotes', 'options']) &&
          request.resource.data.question == resource.data.question &&
          (!('type' in resource.data) || request.resource.data.type == resource.data.type) &&
          resource.data.voters is list &&
          request.resource.data.voters is list &&
          !resource.data.voters.hasAny([request.auth.uid]) &&
          request.resource.data.voters.hasAll(resource.data.voters) &&
          request.resource.data.voters.hasAny([request.auth.uid]) &&
          request.resource.data.voters.size() == resource.data.voters.size() + 1 &&
          request.resource.data.totalVotes == resource.data.totalVotes + 1 &&
          resource.data.options is list &&
          request.resource.data.options is list &&
          request.resource.data.options.size() == resource.data.options.size() &&
          isValidOptionIncrement()
        )
      );
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // JOBS COLLECTION
    // ============================================
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && notModifyingOwner('userId');
      allow delete: if (isOwner(resource.data.userId) || isAdmin());
    }

    match /job_applications/{applicationId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isOwner(resource.data.jobOwnerId) || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.userId) || isOwner(resource.data.jobOwnerId) || isAdmin()) &&
                      notModifyingOwner('userId') && notModifyingOwner('jobOwnerId');
      allow delete: if isAdmin();
    }

    // ============================================
    // FOLLOWS COLLECTION
    // ============================================
    match /follows/{followId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.followerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(resource.data.followerId) || isAdmin());
    }

    // ============================================
    // AD CAMPAIGNS COLLECTION
    // ============================================
    match /ad_campaigns/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // FACILITIES/SERVICES COLLECTION
    // ============================================
    match /facilities/{facilityId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && notModifyingOwner('userId');
      allow delete: if (isOwner(resource.data.userId) || isAdmin());
    }
    
    // ============================================
    // GUILDS COLLECTION
    // ============================================
    match /guilds/{guildId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /guild_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && notModifyingOwner('userId');
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /guild_comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.userId) || isAdmin()) && notModifyingOwner('userId');
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /guild_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ============================================
    // GROUPS & FORUM POSTS COLLECTION
    // ============================================
    match /groups/{groupId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.creatorId == request.auth.uid || isAdmin());
      
      // Strict helper function to check if join/leave strictly modifies only caller's UID:
      // - Both old and new members must be valid lists
      // - Standard users can only join open/public groups (cannot self-join private/gated groups)
      // - Joining: exactly caller's UID added; previous list preserved; length increments by 1
      // - Leaving: exactly caller's UID removed; remaining list preserved; length decrements by 1
      // - memberCount MUST equal the exact length of the new members list
      function isValidMembershipToggle() {
        let isPublicGroup = !('isPrivate' in resource.data) || resource.data.isPrivate == false;
        let oldMembersValid = resource.data.members is list;
        let newMembersValid = request.resource.data.members is list;
        
        let isJoining = isPublicGroup &&
                        !resource.data.members.hasAny([request.auth.uid]) &&
                        request.resource.data.members.hasAny([request.auth.uid]) &&
                        request.resource.data.members.hasAll(resource.data.members) &&
                        request.resource.data.members.size() == resource.data.members.size() + 1;
                        
        let isLeaving = resource.data.members.hasAny([request.auth.uid]) &&
                        !request.resource.data.members.hasAny([request.auth.uid]) &&
                        resource.data.members.hasAll(request.resource.data.members) &&
                        request.resource.data.members.size() == resource.data.members.size() - 1;
                        
        return oldMembersValid && newMembersValid && (isJoining || isLeaving) &&
               request.resource.data.memberCount == request.resource.data.members.size();
      }

      allow update: if isAuthenticated() && (
        (isOwner(resource.data.creatorId) && notModifyingOwner('creatorId')) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberCount']) &&
          notModifyingOwner('creatorId') &&
          notModifyingOwner('name') &&
          notModifyingOwner('category') &&
          isValidMembershipToggle()
        ) ||
        isAdmin()
      );
      
      allow delete: if isOwner(resource.data.creatorId) || isAdmin();
    }

    match /forumPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.authorId) || isAdmin()) && notModifyingOwner('authorId');
      allow delete: if (isOwner(resource.data.authorId) || isAdmin());
    }

    match /forum_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if (isOwner(resource.data.authorId) || isAdmin()) && notModifyingOwner('authorId');
      allow delete: if (isOwner(resource.data.authorId) || isAdmin());
    }

    // ============================================
    // ADS COLLECTION
    // ============================================
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // DEFAULT DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
